[Unit]
Description=crypto-pilot archive mirror upload (one-shot, low priority)
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
Nice=10
ExecStart=%h/crypto-pilot/deploy/archive-mirror/run.sh
# The longest session starts 06:45 UTC; this ends it before the 23:03 live cycle.
TimeoutStartSec=16h12min
