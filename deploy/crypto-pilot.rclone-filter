# crypto-pilot rclone filter: keep only irreplaceable streams.
# rclone applies the first matching rule from the top, so transient-file
# exclusions precede every include; an exclusion after a broader include never fires.

# Exclude transient partial writes (must stay before every include: first match wins).
- *.tmp
- *.tmp-*
- *.partial
# Keep strategy run records (ledgers, fills, manifests) which cannot be re-downloaded.
+ /state/**
# Keep sealed research archives which cannot be regenerated deterministically.
+ /archive/**
# Keep liquidation stream captures which are only observable live.
+ /futures/liquidations/**
# Keep venue rule snapshots which pin historical execution constraints.
+ /futures/venue_rules/**
# Keep live-only captured market sources (top-of-book, premium index, raw reference, coverage).
- /live_capture/raw/hot/**
- /live_capture/raw/*.json
+ /live_capture/raw/archive/**
+ /live_capture/**
# Exclude re-downloadable market data (ohlcv, markPriceKlines, funding, metrics).
- /futures/**
# Exclude everything else by default.
- **
