{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/champion.schema.json",
  "title": "ChampionRecord",
  "type": "object",
  "required": ["schema_version", "metrics"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": { "type": "string" },
    "promoted_at": { "type": "string" },
    "note": { "type": "string" },
    "architecture": { "type": "string" },
    "parameters": { "type": "object" },
    "gates": { "type": "object" },
    "metrics": {
      "type": "object",
      "required": [
        "oos_cagr_pct",
        "oos_mdd_pct",
        "oos_net_alpha_pct",
        "oos_sharpe_ratio",
        "pbo_paired"
      ],
      "properties": {
        "oos_cagr_pct": { "type": "number" },
        "oos_mdd_pct": { "type": "number" },
        "oos_net_alpha_pct": { "type": "number" },
        "oos_sharpe_ratio": { "type": "number" },
        "pbo_paired": { "type": "number" }
      },
      "additionalProperties": true
    }
  }
}
